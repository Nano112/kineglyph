{
  "name": "@kineglyph/scenes",
  "version": "0.1.0",
  "description": "The Kineglyph illustration catalogue: eight Nucleation scenes and three product themes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "*"
  },
  "devDependencies": {
    "@kineglyph/export": "*",
    "@kineglyph/svg": "*"
  }
}
