{
  "name": "@kineglyph/math",
  "version": "0.3.1",
  "description": "TeX math as deterministic path data for Kineglyph scenes",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "tex",
    "latex",
    "math",
    "svg",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/math"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/math#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "^0.3.1",
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
