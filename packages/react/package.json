{
  "name": "@kineglyph/react",
  "version": "0.1.0",
  "description": "Responsive React bindings for Kineglyph.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "react",
    "diagram",
    "svg",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.tsx",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/anime": "^0.1.0",
    "@kineglyph/core": "^0.1.0",
    "@kineglyph/svg": "^0.1.0",
    "@kineglyph/web": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
