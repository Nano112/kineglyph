{
  "name": "@kineglyph/export",
  "version": "0.4.1",
  "description": "Deterministic SVG, PNG (resvg), and GIF export for Kineglyph scenes.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "svg",
    "png",
    "gif",
    "export",
    "resvg",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/export"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/export#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kineglyph-export": "./dist/cli.js",
    "kineglyph": "./dist/doctor-cli.js",
    "kineglyph-doctor": "./dist/doctor-cli.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "^0.3.1",
    "@kineglyph/svg": "^0.3.1",
    "@kineglyph/web": "^0.3.1",
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3",
    "harfbuzzjs": "^1.6.0"
  }
}
