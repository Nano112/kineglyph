{
  "name": "@kineglyph/export",
  "version": "0.2.0",
  "description": "Deterministic SVG, PNG (resvg), and GIF export for Kineglyph scenes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/cli.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kineglyph-export": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "*",
    "@kineglyph/svg": "*",
    "@kineglyph/web": "*",
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3"
  }
}
