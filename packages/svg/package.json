{
  "name": "@kineglyph/svg",
  "version": "0.3.1",
  "description": "Deterministic, accessible SVG rendering for Kineglyph scenes",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "svg",
    "renderer",
    "diagram",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/svg"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/svg#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "^0.3.1"
  }
}
