{
  "name": "@kineglyph/web",
  "version": "0.3.1",
  "description": "Framework-neutral browser runtime for Kineglyph figures: mount, control, inspect, and dispose.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "diagram",
    "svg",
    "browser",
    "runtime",
    "interactive",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "development": "./src/bundle.ts",
      "import": "./dist/kineglyph-web.js"
    },
    "./lab": {
      "types": "./dist/lab.d.ts",
      "development": "./src/lab.ts",
      "import": "./dist/lab.js"
    },
    "./editor": {
      "types": "./dist/lab.d.ts",
      "development": "./src/lab.ts",
      "import": "./dist/lab.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "development": "./src/runtime.ts",
      "import": "./dist/runtime.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "development": "./src/canvas.ts",
      "import": "./dist/canvas.js"
    },
    "./micro": {
      "types": "./dist/micro.d.ts",
      "development": "./src/micro.ts",
      "import": "./dist/micro.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "development": "./src/stream.ts",
      "import": "./dist/stream.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces.d.ts",
      "development": "./src/surfaces.ts",
      "import": "./dist/surfaces.js"
    },
    "./controls": {
      "types": "./dist/controls.d.ts",
      "development": "./src/controls.ts",
      "import": "./dist/controls.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "development": "./src/worker.ts",
      "import": "./dist/worker.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "development": "./src/doctor.ts",
      "import": "./dist/doctor.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "development": "./src/export.ts",
      "import": "./dist/export.js"
    },
    "./shaders": {
      "types": "./dist/shaders.d.ts",
      "development": "./src/shaders.ts",
      "import": "./dist/shaders.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@kineglyph/anime": "^0.3.1",
    "@kineglyph/core": "^0.3.1",
    "@kineglyph/math": "^0.3.1",
    "@kineglyph/plot": "^0.3.1",
    "@kineglyph/svg": "^0.3.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
