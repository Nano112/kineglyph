{
  "name": "@kineglyph/plot",
  "version": "0.2.0",
  "description": "Pure chart compiler for Kineglyph: scales, series, axes, and annotations compiled to core scene fragments.",
  "license": "MIT",
  "author": "Harrison (https://github.com/Nano112)",
  "keywords": [
    "chart",
    "plot",
    "dataviz",
    "svg",
    "kineglyph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nano112/kineglyph.git",
    "directory": "packages/plot"
  },
  "homepage": "https://github.com/Nano112/kineglyph/tree/main/packages/plot#readme",
  "bugs": {
    "url": "https://github.com/Nano112/kineglyph/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/__tests__",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kineglyph/core": "^0.2.0"
  },
  "devDependencies": {
    "@kineglyph/export": "^0.3.0",
    "@kineglyph/svg": "^0.2.0"
  }
}
